{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "200000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node mw.js status --context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node mw.js inbox",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
